<!-- Project Configuration File (PCMonitor.csproj)
- Purpose:
+ Defines the .NET application project configuration.
+ Targets the .NET 10 framework.
+ Configures implicit usings and nullable reference types.
+ Includes LibreHardwareMonitorLib for accessing PC hardware sensors such as CPU/GPU temperatures, power, voltage, and fan speed.
  Author: Chu Xuân Hồng
  Time (dd/mm/yyyy): 08/10/2026
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
</Project>